# Copy to research/.env and fill in as needed.

# OpenAI (baseline_gpt generation and naturalness_llm_judge).
OPENAI_API_KEY=

# Naturalness LLM judge — optional overrides.
#   OPENAI_JUDGE_MODEL takes precedence over OPENAI_MODEL, then falls back
#   to the built-in default (gpt-5.4-mini).
OPENAI_JUDGE_MODEL=
OPENAI_MODEL=

# Fluency perplexity — optional overrides for the Hugging Face causal LM.
#   Defaults: model=BSC-LT/salamandra-2b, dtype=bfloat16, revision=<none>
NATURALNESS_PPL_MODEL=
NATURALNESS_PPL_DTYPE=
NATURALNESS_PPL_REVISION=

# Cysill Ar-lein (Welsh spelling/grammar/mutation checker).
# Register a free key at https://api.techiaith.org — required for grammar_cysill.
# Rate-limited (often a few hundred calls/hour); responses are disk-cached.
CYSILL_API_KEY=
# Optional overrides:
# CYSILL_API_ENDPOINT=https://api.techiaith.org/cysill/v1/
# CYSILL_CACHE_DIR=
